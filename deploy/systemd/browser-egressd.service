[Unit]
Description=browserd egress daemon (single host)
After=network.target

[Service]
Type=exec
User=browserd
Group=browserd
EnvironmentFile=/etc/browserd/browserd.env
ExecStart=/usr/bin/env ${BROWSERD_RELEASE_ROOT}/bin/browser-egressd
ExecStartPost=/usr/bin/python3 ${BROWSERD_RELEASE_ROOT}/deploy/wait_ready.py egress
StateDirectory=browserd/egress
StateDirectoryMode=0700
RuntimeDirectory=browserd
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0077
Restart=no
TimeoutStartSec=90
TimeoutStopSec=60
KillMode=mixed

[Install]
WantedBy=multi-user.target
