# Single Linux host, exactly one worker, dedicated_process sessions. This is NOT a configured deployment.
# Copy outside the release tree to /etc/browserd/browserd.env, owner root, mode 0600.
# systemd EnvironmentFile does not expand $VARIABLE references: repeated paths/values must match.
# The templates use one browserd service UID; gateway and worker MUST currently share that UID.
BROWSERD_RELEASE_ROOT=/opt/browserd/releases/REPLACE_RELEASE_ID
BROWSERD_WORKER_ID=browserd-worker-1
BROWSER_EGRESS_WORKER_ID=browserd-worker-1
BROWSERD_INTERNAL_PEER=browserd-gateway
BROWSERD_PLACEMENT_VERSION=1

# Replace all four with deploy/next_epochs.py output ONLY while every daemon is stopped.
BROWSERD_WORKER_EPOCH=REPLACE_NEXT_WORKER_EPOCH
BROWSER_EGRESS_WORKER_EPOCH=REPLACE_NEXT_WORKER_EPOCH
BROWSERD_EGRESS_DAEMON_EPOCH=REPLACE_NEXT_EGRESS_EPOCH
BROWSERD_SANDBOXD_EPOCH=REPLACE_NEXT_SANDBOX_EPOCH
BROWSERD_WORKER_EPOCH_FILE=/var/lib/browserd/worker/epoch
BROWSER_EGRESS_DAEMON_EPOCH_STATE=/var/lib/browserd/egress/epoch
BROWSERD_SANDBOXD_EPOCH_STATE=/var/lib/browserd/sandbox/epoch

# All five UID bindings equal `id -u browserd` for these unit templates.
BROWSERD_WORKER_UID=REPLACE_BROWSERD_UID
BROWSERD_SANDBOX_EXPECTED_PEER_UID=REPLACE_BROWSERD_UID
BROWSERD_SANDBOX_EXPECTED_SERVER_UID=REPLACE_BROWSERD_UID
BROWSERD_EGRESS_EXPECTED_SERVER_UID=REPLACE_BROWSERD_UID
BROWSER_EGRESS_EXPECTED_PEER_UID=REPLACE_BROWSERD_UID
BROWSERD_WORKER_SOCKET=/run/browserd/worker.sock
BROWSERD_INTERNAL_ENDPOINT=unix:/run/browserd/worker.sock
BROWSERD_SANDBOX_SOCKET=/run/browserd/sandbox.sock
BROWSERD_EGRESS_INSTALL_SOCKET=/run/browserd/egress-install.sock
BROWSER_EGRESS_INSTALL_SOCKET=/run/browserd/egress-install.sock
BROWSERD_EGRESS_CONTROL_URL=http://127.0.0.1:9081
BROWSER_EGRESS_CONTROL_BIND=127.0.0.1:9081

# Two distinct >=32-character secrets; each pair across daemons must contain the SAME value.
BROWSERD_EGRESS_WORKER_TOKEN=REPLACE_WORKER_TOKEN
BROWSER_EGRESS_WORKER_TOKEN=REPLACE_WORKER_TOKEN
BROWSERD_EGRESS_SUPERVISOR_TOKEN=REPLACE_SUPERVISOR_TOKEN
BROWSER_EGRESS_SUPERVISOR_TOKEN=REPLACE_SUPERVISOR_TOKEN
BROWSERD_EGRESS_POLICY_PROFILE=public-web-default
BROWSERD_EGRESS_POLICY_DIGEST=REPLACE_64_HEX_POLICY_DIGEST
BROWSERD_EGRESS_REQUEST_TIMEOUT_MILLIS=5000
BROWSERD_EGRESS_MAX_RESPONSE_BYTES=65536
BROWSER_EGRESS_MAX_CONTROL_CONNECTIONS=128
BROWSER_EGRESS_MAX_LEASE_MILLIS=30000
BROWSER_EGRESS_MAX_PLANS=256
BROWSER_EGRESS_MAX_CONNECTIONS_PER_ROUTE=64
BROWSER_EGRESS_MAX_CONNECTION_STARTS_PER_MINUTE=1200
BROWSER_EGRESS_MAX_DNS_PER_MINUTE=600
BROWSER_EGRESS_MAX_BYTES_PER_MINUTE=67108864
BROWSER_EGRESS_MAX_TOTAL_BYTES=1073741824
BROWSER_EGRESS_MAX_RESPONSE_BYTES=33554432
BROWSER_EGRESS_IDLE_TIMEOUT_MILLIS=30000

# Root-owned, immutable release paths; match compatibility.json and the qualified runtime mounts.
BROWSERD_CHROMIUM_ARTIFACT_ROOT=/opt/browserd/releases/REPLACE_RELEASE_ID/chromium
BROWSERD_CHROMIUM_HOST_EXECUTABLE=/opt/browserd/releases/REPLACE_RELEASE_ID/chromium/REPLACE_BINARY_RELATIVE_PATH
BROWSERD_CHROMIUM_BINARY_SHA256=REPLACE_64_HEX_BINARY_DIGEST
BROWSERD_CHROMIUM_SANDBOX_EXECUTABLE=/opt/browser/chromium
# Optional private worker-owned 0600 JSON in a 0700 directory. Missing qualification
# or tenant authorization keeps dedicated/max-one placement; see README for limits.
# BROWSERD_SHARED_CONTEXT_POLICY_FILE=/var/lib/browserd/worker-policy/shared-context.json
BROWSERD_LAUNCH_GATE_HOST_EXECUTABLE=/opt/browserd/releases/REPLACE_RELEASE_ID/bin/browserd-launch-gate
BROWSERD_LAUNCH_GATE_SANDBOX_EXECUTABLE=/opt/browser/launch-gate
BROWSERD_BWRAP_EXECUTABLE=/usr/bin/bwrap
BROWSERD_SANDBOX_READ_ONLY_MOUNTS_JSON=REPLACE_QUALIFIED_MOUNTS_JSON
# Wrapper-only setting; run-sandbox.sh opens this approved binary filter on FD5.
BROWSERD_SANDBOX_SECCOMP_FILTER=/etc/browserd/REPLACE_QUALIFIED_SECCOMP_FILTER.bpf
BROWSERD_SANDBOX_SECCOMP_FD=5
BROWSERD_SANDBOX_JOURNAL_DIR=/var/lib/browserd/sandbox/journal
BROWSERD_SANDBOX_RUNTIME_ROOT=/var/lib/browserd/sandboxes
# Must be an existing writable child under the operator-qualified delegated cgroup v2 tree.
BROWSERD_SANDBOX_CGROUP_ROOT=REPLACE_DELEGATED_CGROUP_SUBTREE
BROWSERD_SANDBOX_MEMORY_MAX_BYTES=2147483648
BROWSERD_SANDBOX_MEMORY_HIGH_BYTES=1610612736
BROWSERD_SANDBOX_PIDS_MAX=512
BROWSERD_SANDBOX_CPU_QUOTA=200000
BROWSERD_SANDBOX_CPU_PERIOD=100000
BROWSERD_SUPERVISOR_LEASE_MILLIS=15000
BROWSERD_DIRECTORY_LEASE_MILLIS=30000
BROWSERD_SANDBOX_CLEANUP_TIMEOUT_MILLIS=10000
BROWSERD_SANDBOX_RPC_TIMEOUT_MILLIS=5000
BROWSERD_SANDBOX_LEASE_SWEEP_MILLIS=1000
BROWSERD_SANDBOX_RPC_MAX_FRAME_BYTES=4194304
BROWSERD_SANDBOX_RPC_MAX_CONNECTIONS=128
BROWSERD_SANDBOX_TERMINATION_GRACE_MILLIS=3000
BROWSERD_SANDBOX_PROCESS_POLL_MILLIS=50
BROWSERD_SANDBOX_RECOVERY_TIMEOUT_MILLIS=30000
BROWSERD_SANDBOX_RECOVERY_CONCURRENCY=8

# Audit is mandatory. Artifact root must exist, have mode0700, and be owned by the worker UID.
BROWSERD_ACTION_JOURNAL_DIR=/var/lib/browserd/worker/actions
# Existing private mode0700 directory, worker-owned. Aggregate limits include metadata reserves.
BROWSERD_ACTION_JOURNAL_MAX_WORKER_BYTES=1073741824
BROWSERD_ACTION_JOURNAL_MAX_TENANT_BYTES=268435456
BROWSERD_ACTION_JOURNAL_MAX_WORKER_INODES=3072
BROWSERD_ACTION_JOURNAL_MAX_TENANT_INODES=384
# Minimum24h, measured from latest confirmed seal/copy ACK/final release.
BROWSERD_ACTION_JOURNAL_RETENTION_MILLIS=86400000
BROWSERD_AUDIT_WAL_FILE=/var/lib/browserd/worker/audit.wal
# Default: observations allowed; other actions require external approval (four eyes).
# Optional immutable exact tenant/principal/action/origin policy, private 0600 file in 0700 directory.
# BROWSERD_ACTION_APPROVAL_POLICY_FILE=/var/lib/browserd/worker/action-approval.json
BROWSERD_ARTIFACT_ROOT=/var/lib/browserd/worker/artifacts
BROWSERD_ARTIFACT_MAX_FILE_BYTES=33554432
BROWSERD_ARTIFACT_MAX_WORKER_BYTES=1073741824
BROWSERD_ARTIFACT_MAX_WORKER_IN_FLIGHT_BYTES=134217728
BROWSERD_ARTIFACT_MAX_SESSION_BYTES=134217728
BROWSERD_ARTIFACT_MAX_SESSION_IN_FLIGHT_BYTES=67108864
BROWSERD_ARTIFACT_MAX_RETAINED_ARTIFACTS=10000
BROWSERD_ARTIFACT_MAX_OPERATIONS=32
BROWSERD_ARTIFACT_CHUNK_BYTES=65536
BROWSERD_ARTIFACT_OPERATION_TIMEOUT_MS=30000
# Optional upload scanner; absent configuration allows generated captures only and rejects uploads.
# BROWSERD_ARTIFACT_SCANNER_SOCKET=/run/clamav/clamd.ctl
# BROWSERD_ARTIFACT_SCANNER_UID=REPLACE_SCANNER_UID
# Set the authenticated clamd service's TZ=UTC before enabling this contract.
# BROWSERD_ARTIFACT_SCANNER_TIMESTAMP_TIMEZONE=UTC
# BROWSERD_ARTIFACT_SCANNER_MAX_DATABASE_AGE_MS=172800000
# BROWSERD_ARTIFACT_SCANNER_MAX_FUTURE_SKEW_MS=300000
# Nonclean scans retain metadata only by default. Private byte retention requires
# an authenticated scanner, ENABLED=true and all five positive limits together.
# Retention is at most 24h; byte/count limits must not exceed the artifact limits
# above. Leave all five limits unset when retention is disabled. Existing private
# records still recover and expire after notification ACK when disabled.
BROWSERD_ARTIFACT_QUARANTINE_ENABLED=false
# BROWSERD_ARTIFACT_QUARANTINE_RETENTION_MS=3600000
# BROWSERD_ARTIFACT_QUARANTINE_MAX_FILE_BYTES=8388608
# BROWSERD_ARTIFACT_QUARANTINE_MAX_WORKER_BYTES=67108864
# BROWSERD_ARTIFACT_QUARANTINE_MAX_SESSION_BYTES=16777216
# BROWSERD_ARTIFACT_QUARANTINE_MAX_RETAINED_ARTIFACTS=128

BROWSERD_BIND=127.0.0.1:8080
BROWSERD_TRUST_TLS_TERMINATOR=false
BROWSERD_AUTH_ISSUER=browserd-local
BROWSERD_AUTH_AUDIENCE=browserd
BROWSERD_AUTH_KEY_ID=key-1
BROWSERD_AUTH_HMAC_SECRET=REPLACE_AUTH_SECRET
BROWSERD_POSTGRES_URL=REPLACE_POSTGRES_URL
# Global runtime safety authority: gateway, worker and egressd MUST use the same
# Redis URL/prefix. Explicit authenticated safety Initialize is required before
# browser admission; startup transport reachability does not initialize it.
BROWSERD_REDIS_URL=REPLACE_REDIS_URL
BROWSERD_REDIS_PREFIX=browserd-production
# Keep BROWSERD_SAFETY_STATE_FILE unset in this shared EnvironmentFile. Worker
# defaults to its control-event journal path with extension safety-state; egressd
# defaults to its epoch-state path with that extension. A per-service override
# must use distinct absolute private files in service-owned 0700 directories.
# Preserve the safety pin and .lock files across restarts; never delete to retry.
# Retained action payloads; configure the same bounds for the offline action_migrate tool.
# Namespace range 1..1048576; session range 1..65536 and <= namespace.
BROWSERD_ACTION_MAX_RETAINED_RECORDS=65536
BROWSERD_ACTION_MAX_RETAINED_RECORDS_PER_SESSION=4096
BROWSERD_VIEWER_ORIGINS=https://REPLACE_VIEWER_ORIGIN
# Durable control notifications and per-session counters; retain across restarts and rollback.
BROWSERD_CONTROL_EVENT_JOURNAL_FILE=/var/lib/browserd/worker/control-events.json
BROWSERD_WORKER_RPC_QUEUE=256
BROWSERD_WORKER_RPC_IN_FLIGHT=32
BROWSERD_WORKER_RPC_TIMEOUT_MS=30000
BROWSERD_COORDINATION_QUEUE=256
BROWSERD_COORDINATION_IN_FLIGHT=32
BROWSERD_COORDINATION_QUERY_TIMEOUT_MS=5000
BROWSERD_COORDINATION_MUTATION_TIMEOUT_MS=10000
BROWSERD_CREATE_LEASE_MS=30000
BROWSERD_POSTGRES_MAX_CONNECTIONS=8
